from flask import Flask, send_file, request, jsonify
from flask_cors import CORS
import os
import uuid
import requests
from datetime import datetime

app = Flask(__name__)
CORS(app)

# Create videos folder
os.makedirs('videos', exist_ok=True)

@app.route('/')
def index():
    return send_file('index.html')

@app.route('/generate', methods=['POST'])
def generate():
    data = request.json
    prompt = data.get('prompt', '')
    
    # Generate a unique filename
    filename = f"video_{uuid.uuid4().hex[:8]}.mp4"
    filepath = os.path.join('videos', filename)
    
    # For demo: download a sample video based on prompt keywords
    if 'banana' in prompt.lower():
        video_url = "https://sample-videos.com/video123/mp4/720/big_buck_bunny_720p_1mb.mp4"
    elif 'intro' in prompt.lower():
        video_url = "https://sample-videos.com/video123/mp4/720/big_buck_bunny_720p_2mb.mp4"
    else:
        video_url = "https://sample-videos.com/video123/mp4/720/big_buck_bunny_720p_5mb.mp4"
    
    # Download the video
    response = requests.get(video_url)
    with open(filepath, 'wb') as f:
        f.write(response.content)
    
    return jsonify({
        'success': True,
        'video_url': f'/download/{filename}',
        'prompt': prompt,
        'timestamp': datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    })

@app.route('/download/<filename>')
def download(filename):
    return send_file(os.path.join('videos', filename), as_attachment=True)

if __name__ == '__main__':
    app.run(debug=True, port=5000)
